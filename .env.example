# Copy to .env — it's gitignored. Every npm script here loads it automatically.

# --- Discord ---

# Developer Portal -> your app -> Bot -> Reset Token.
# Also switch on Privileged Gateway Intents -> Message Content while you're there.
DISCORD_TOKEN=

# Channels the bot listens in, comma separated. Enable Developer Mode in
# Discord (Settings -> Advanced), then right-click a channel -> Copy Channel ID.
DISCORD_CHANNEL_IDS=

# Optional allow-list of user ids, for both requesting changes and approving
# them. Blank means anyone who can post in those channels.
DISCORD_ALLOWED_USER_IDS=

# --- Game server ---

# The bot runs the game server as a child process so it can restart it when a
# change lands. Set false to leave the server entirely to you — landed changes
# will then just tell you to restart it yourself.
# If something is already listening on PORT at startup, the bot leaves it alone
# regardless of this setting.
MANAGE_GAME_SERVER=true
PORT=2567

# Run bin/cloudflared and post the public URL to Discord on startup. The tunnel
# is never restarted with the server, so the address survives a landed change.
# Skipped automatically if bin/cloudflared isn't there.
MANAGE_TUNNEL=true

# --- Worker ---

# How often to look for queued requests, in ms. New messages also nudge it
# immediately, so this is really just the fallback.
WORKER_INTERVAL_MS=300000

# Requests per agent run.
BATCH_LIMIT=10

# How long the agent gets before it's killed, in ms.
AGENT_TIMEOUT_MS=900000

# Push to origin after a 🚀 reaction. Set false to commit locally only.
PUSH_ON_LAND=true

# --- Queue ---

QUEUE_BACKEND=file
# QUEUE_DIR=.queue
